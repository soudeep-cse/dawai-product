# ========================================
# VPS Production Environment Variables
# ========================================

# Database Configuration
DB_USER="dawai_prod_user"
DB_PASSWORD="CHANGE_THIS_TO_STRONG_PASSWORD"
DB_NAME="dawai_prod"

# App Configuration
NODE_ENV="production"
NEXT_PUBLIC_APP_URL="https://your-domain.com"

# JWT Secret (generate: openssl rand -base64 32)
JWT_SECRET="CHANGE_THIS_TO_RANDOM_VALUE"

# OpenAI API Key
OPENAI_API_KEY="sk-your-actual-key-here"

# Firebase Auth (client config - from Firebase Console > Project Settings > Your apps)
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""
NEXT_PUBLIC_FIREBASE_PROJECT_ID="dawai-platform"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""

# Firebase Admin (server-side - from Firebase Console > Project Settings > Service Accounts)
FIREBASE_PROJECT_ID="dawai-platform"
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""

# File Upload
MAX_FILE_SIZE="5242880"
UPLOAD_DIR="public/uploads"

# Security
NEXT_PUBLIC_SECURE_COOKIES="true"
CORS_ORIGIN="https://your-domain.com"

# Logging
LOG_LEVEL="info"
SENTRY_DSN=""  # Optional: error tracking service

# ========================================
# Optional: Payment Gateway (Stripe/bKash)
# ========================================
# STRIPE_SECRET_KEY=""
# STRIPE_PUBLISHABLE_KEY=""
# BKASH_API_KEY=""
