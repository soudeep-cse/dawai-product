# Database
DATABASE_URL="postgresql://user:password@localhost:5432/dawai"

# OpenAI API (For Prescription AI Analysis)
OPENAI_API_KEY="sk-your-openai-api-key-here"

# JWT Secret (for admin auth)
JWT_SECRET="your-secure-jwt-secret-here"

# Image Upload (if using external storage)
# AWS_ACCESS_KEY_ID="your-aws-key"
# AWS_SECRET_ACCESS_KEY="your-aws-secret"
# AWS_S3_BUCKET="dawai-prescriptions"
# AWS_S3_REGION="ap-southeast-1"

# Email Service (optional)
# SENDGRID_API_KEY="your-sendgrid-key"
# SMTP_HOST="smtp.gmail.com"
# SMTP_PORT="587"
# SMTP_USER="your-email@gmail.com"
# SMTP_PASS="your-email-password"

# SMS Service (for OTP)
# TWILIO_ACCOUNT_SID="your-twilio-sid"
# TWILIO_AUTH_TOKEN="your-twilio-token"
# TWILIO_PHONE_NUMBER="+1234567890"

# Payment Gateway (Phase 8)
# BKASH_API_KEY="your-bkash-key"
# NAGAD_API_KEY="your-nagad-key"
# STRIPE_SECRET_KEY="your-stripe-key"

# Admin Settings
ADMIN_EMAIL="admin@dawai.com"
ADMIN_PASSWORD_INITIAL="change-me-on-first-login"

# Next.js
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
